# Antrothon'27 Environment Variables

# App Configuration
APP_ENV=development
SECRET_KEY=cyberdyne_t800_antrothon_secret_key_2027
PORT=8000
HOST=127.0.0.1

# Admin Credentials (Change in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=terminator2027

# ─── Supabase Database ───────────────────────────────────────────────
# Enter your Supabase PostgreSQL connection string below:
# Direct connection (port 5432):
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.[PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler (recommended, port 6543):
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:YOUR_PASSWORD@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# Supabase API (Optional / For client SDK)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Razorpay API Credentials ────────────────────────────────────────
# Add your Razorpay Key ID and Secret below.
# If left empty, system operates in high-fidelity sandbox/simulator mode for testing!
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Google Drive Direct Storage ─────────────────────────────────────
# When participants submit their presentation, files are uploaded directly
# to your Google Drive and the shareable link is saved in Supabase.
# Option 1 (Zero-Cloud / No Organization Restrictions): Google Apps Script Webhook
# GOOGLE_DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# Option 2: Google Service Account
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Destination Folder ID in your Google Drive (from drive.google.com folder URL):
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_WEBHOOK_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_API_KEY=

# Event Timings & Fees
REGISTRATION_FEE_INR=300
FINALIST_FEE_PER_HEAD_INR=350
MIN_TEAM_MEMBERS=4
MAX_TEAM_MEMBERS=6

# Milestone Dates (ISO Format YYYY-MM-DDTHH:MM:SS)
# Registration & Problem Statements locked until this date:
REGISTRATION_OPEN_DATE=2026-10-30T00:00:00
REGISTRATION_DEADLINE=2026-12-20T23:59:59
FINALIST_ANNOUNCEMENT_DATE=2026-12-27T18:00:00
HACKATHON_START_DATE=2027-01-07T09:00:00
HACKATHON_END_DATE=2027-01-08T09:00:00

# Testing / Developer Override: Set to True if you want to bypass the 30 Oct lock to test registration
FORCE_UNLOCK_REGISTRATION=false

# ─── SMTP Email (Gmail) ─────────────────────────────────────────────
# Sends confirmation email after successful registration + payment.
# Use your Gmail address and a 16-character App Password:
# https://myaccount.google.com/apppasswords
SMTP_EMAIL=
SMTP_APP_PASSWORD=
